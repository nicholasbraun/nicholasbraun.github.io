# Local paths used by `npm run sync-cv`. Copy this file to .env and point the
# values at your own machine. .env is gitignored on purpose: this repo is
# public, so real filesystem paths must not be committed.

# MCP config file holding the Reactive Resume URL and API key.
RXRESUME_MCP_CONFIG=~/path/to/.mcp.json

# Directory holding the Reactive Resume docker-compose setup. Optional — only
# used to make the "instance is not running" error message actionable.
RXRESUME_DIR=~/path/to/rxresume
